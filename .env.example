APP_NAME="E-5 Pengawasan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=e5_pengawasan
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# E-5 (config/e5.php): mock = read F-1/D-1 data from database/mocks
INTEGRATION_MODE=mock

# Run one integration live while the others stay mock (see doc/INTEGRASI_LIVE.md):
# F1_MODE=live
# D1_MODE=live
# F1_BASE_URL=http://127.0.0.1:4100          # F-1 demo server has no /api/v1; the contract does
# F1_JWT_SECRET=                             # same value as F-1's JWT_SECRET
# F1_SERVICE_TOKEN=                          # optional, F-1 has none yet
# F1_ROLE_MAP=PM:PM,TL:TL,TW:TW              # F-1 roleCode:E-5 role; F-1 has no TL/TW yet
# D1_BASE_URL=http://localhost:3000/api/v1
# D1_TOKEN=                                  # D-1 has no auth yet
# D1_ACTIVE_STATUSES=REGISTERED
# UPSTREAM_TIMEOUT=3
# E5_PROJECT_MEMBERS_FILE=                   # defaults to storage/app/project_members.json
DISPLAY_TIMEZONE=Asia/Jakarta

# BL-12: DELAYED when actual progress is below target by more than this many points (Q-10)
INDICATOR_TOLERANCE=0
